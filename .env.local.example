# ------------------------------------------------------------------
# Aamna's Elixir — environment variables
# Copy to .env.local and fill in as needed.
# ------------------------------------------------------------------

# Commerce mode: "mock" (default) or "shopify".
# "mock" runs the local demo storefront + cart; no real payments.
NEXT_PUBLIC_COMMERCE_MODE=mock

# Shopify Storefront API (server-side only — required only when
# NEXT_PUBLIC_COMMERCE_MODE=shopify). Never expose these to the browser.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
